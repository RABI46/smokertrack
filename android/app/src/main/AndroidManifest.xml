<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      SmokeTracker fonctionne entièrement hors-ligne : l'export statique est
      embarqué dans l'APK. Aucune permission de localisation, de contact, de
      stockage ou de santé n'est demandée.
    -->

    <application
        android:allowBackup="true"
        android:fullBackupContent="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Widget d'écran d'accueil : compteur du jour + ajout rapide. -->
        <receiver
            android:name=".SmokeWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
      Deux permissions, toutes deux liées au fonctionnement local :

      - INTERNET : imposée par le WebView Android (même pour servir des
        fichiers locaux via le schéma https://localhost). Aucune requête
        sortante n'est faite : l'application fonctionne en mode avion.
      - SCHEDULE_EXACT_ALARM : permet au widget de déclencher la bascule du
        compte à rebours (rouge → vert) à l'échéance près sur Android 12+.
        L'application se rabat sur une alarme approximative si l'utilisateur
        révoque l'autorisation (Paramètres → Alarmes et rappels), sans autre
        conséquence qu'un retard de l'ordre de la minute.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
