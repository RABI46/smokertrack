{
  "name": "smokertrack",
  "version": "0.2.0",
  "private": true,
  "description": "Suivi personnel de consommation de cigarettes — PWA Next.js + Firebase",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "emulators": "firebase emulators:start --only auth,firestore",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "10.2.9",
    "firebase": "10.14.1",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "jsdom": "^30.1.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
