<?xml version="1.0" encoding="utf-8"?>
<!--
  Bouton « +1 » du widget, façon liquide : verre teinté sarcelle avec reflet
  lumineux en haut et contour clair, accordé au thème Aurora Glass de l'app.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#50FFFFFF"
        android:centerColor="#14B8A6"
        android:endColor="#0D9488" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="#59FFFFFF" />
</shape>
