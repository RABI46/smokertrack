<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Thème de base : fond sombre dès le lancement pour éviter un flash blanc
         avant l'affichage du WebView. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/appBackground</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/appBackground</item>
        <item name="android:statusBarColor">@color/appBackground</item>
        <item name="android:navigationBarColor">@color/appBackground</item>
    </style>

    <!-- Écran de démarrage : flamme centrée sur fond bleu nuit.
         `postSplashScreenTheme` est obligatoire avec androidx.core:core-splashscreen. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/appBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- Widget « Semaine » : colonne = valeur / barre / initiale du jour. -->
    <style name="WidgetWeekColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">bottom|center_horizontal</item>
    </style>

    <style name="WidgetWeekValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">3dp</item>
        <item name="android:textColor">#9AA8C2</item>
        <item name="android:textSize">10sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- TextView et non View : TextView fait partie des classes garanties dans
         un RemoteViews. La hauteur est écrasée à l'exécution sur Android 12+. -->
    <style name="WidgetWeekBar">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">6dp</item>
        <item name="android:background">@drawable/widget_week_bar_empty</item>
    </style>

    <style name="WidgetWeekDay">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">#7E8CA6</item>
        <item name="android:textSize">9sp</item>
    </style>
</resources>
