rules_version = '2';

// Règles de sécurité Firestore pour SmokeTracker.
// Principe : un utilisateur authentifié n'accède qu'à son propre sous-arbre,
// avec validation des champs écrits (type, bornes, horodatage serveur).
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidDay(data) {
      return data.keys().hasOnly(['count', 'lastSmokedAt'])
        && data.count is int
        && data.count >= 0
        && data.count <= 200
        && data.lastSmokedAt is timestamp;
    }

    // Profil : uniquement l'objectif quotidien.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['goal'])
        && request.resource.data.goal is int
        && request.resource.data.goal >= 1
        && request.resource.data.goal <= 100;

      // Une journée : compteur + horodatage serveur.
      match /daily/{day} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidDay(request.resource.data);
        allow delete: if isOwner(uid);
      }
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
