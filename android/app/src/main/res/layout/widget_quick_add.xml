<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget « +1 » minimal : le compteur du jour et une seule action, sans ouvrir
  l'application. Tient dans une cellule 2×1.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_quick_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#F4F6FB"
            android:textSize="26sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_quick_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_goal_default"
            android:textColor="#9AA8C2"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_quick_add"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:minWidth="96dp"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:background="@drawable/widget_button_background"
        android:text="@string/widget_quick_add"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
