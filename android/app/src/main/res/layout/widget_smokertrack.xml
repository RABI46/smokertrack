<?xml version="1.0" encoding="utf-8"?>
<!--
  Mise en page du widget d'écran d'accueil.
  RemoteViews n'accepte qu'un sous-ensemble de vues : LinearLayout, TextView,
  Chronometer, ImageView… On utilise des TextView stylés plutôt que des Button
  pour rester compatible avec tous les lanceurs.

  Le compte à rebours est un Chronometer : il avance tout seul, sans réveil de
  l'application. `android:format` doit obligatoirement contenir « %s ».
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_label_today"
        android:textColor="#9AA8C2"
        android:textSize="10sp"
        android:letterSpacing="0.08"
        android:textAllCaps="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#F4F6FB"
            android:textSize="30sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_goal_default"
            android:textColor="#9AA8C2"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Prochaine cigarette : libellé + décompte vivant, en grand format.
         Rouge tant que le compte tourne ; SmokeWidgetProvider bascule le texte
         en vert dès que le compte atteint zéro (cf. `setTextColor` ci-contre). -->
    <LinearLayout
        android:id="@+id/widget_next_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/widget_next_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_label_next"
            android:textColor="#9AA8C2"
            android:textSize="11sp"
            android:textAllCaps="true"
            android:letterSpacing="0.06" />

        <Chronometer
            android:id="@+id/widget_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:format="%s"
            android:textColor="#F87171"
            android:textSize="21sp"
            android:textStyle="bold"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_last"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="@string/widget_no_smoke_today"
        android:textColor="#9AA8C2"
        android:textSize="10sp"
        android:paddingTop="2dp" />

    <TextView
        android:id="@+id/widget_add"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:background="@drawable/widget_button_background"
        android:text="@string/widget_add"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
